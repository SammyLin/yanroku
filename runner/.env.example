# Copy to .env. Real environment variables win over this file.
DATA_DIR=data
# local = whisper-cli (whisper.cpp, Metal); groq = Groq Whisper API (audio leaves this machine)
STT_PROVIDER=local
# WHISPER_MODEL=data/models/ggml-large-v3-turbo.bin
WHISPER_LANG=zh
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3
# Groq chunks are cached in DATA_DIR/groq-cache so a quota pause resumes; files older than this Go duration are
# deleted at start and before each Groq transcription (default 168h = 7 days)
# GROQ_CACHE_MAX_AGE=168h
# 0 disables speaker diarization (single speaker)
DIARIZE=1
# 0 = auto-detect speaker count
NUM_SPEAKERS=0
# AI for clean-up / titles / summaries / Ask / vocabulary suggestions. All of them follow LLM_PROVIDER:
# acp (default) = an agent on your own subscription (docs/SELF-HOST.md 4.5); openrouter = OpenRouter API
# (sent with provider.data_collection=deny).
#   Claude Code: npm i -g @agentclientprotocol/claude-agent-acp && claude login
#     ACP_AGENT=claude-agent-acp
#   Codex (ChatGPT plan): npm i -g @openai/codex && codex login; pin a model the adapter supports
#     ACP_AGENT=npx -y @zed-industries/codex-acp -c model=gpt-5.5
ACP_AGENT=claude-agent-acp
# Claude Code model alias (default opus; "opus[1m]" needs usage credits). Ignored by Codex.
ACP_MODEL=opus
# LLM_PROVIDER=acp
# OPENROUTER_API_KEY=
# OpenRouter model per step (defaults shown)
# OPENROUTER_CLEANUP=openai/gpt-5.6-luna
# OPENROUTER_TITLE=openai/gpt-5.6-luna
# OPENROUTER_SUMMARY=openai/gpt-5.6-luna
# OPENROUTER_ASK=openai/gpt-5.6-luna
# OPENROUTER_VOCAB=openai/gpt-5.6-luna
# Worker API: your own Worker URL (behind Cloudflare Access). Required, no default. One Access service token per runner.
API_BASE=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# A multi-user deployment such as Yanroku Cloud (an entry that checks a runner token): that Worker's RUNNER_TOKEN secret, sent as Authorization: Bearer
RUNNER_TOKEN=
# Shown as the job owner; defaults to the hostname
# RUNNER_NAME=
# Empty for self-host. "cloud" makes the runner refuse to start unless the Yanroku Cloud settings below hold.
# RUNNER_PROFILE=
# Error reports to Sentry (empty = off): each error log line (message, ids, error text) and fatal start-up errors.
# SENTRY_DSN=

# --- Yanroku Cloud runner (operator only; self-host leaves all of this commented out) ---
# Uncomment these and delete the same keys above: the first occurrence of a key in this file wins.
# RUNNER_PROFILE=cloud
# STT_PROVIDER=groq
# GROQ_API_KEY=<the 3mi.ai Groq key>
# GROQ_MODEL=whisper-large-v3
# WHISPER_LANG=zh
# GROQ_CACHE_MAX_AGE=168h
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=<the 3mi.ai OpenRouter key>
# OPENROUTER_CLEANUP=openai/gpt-5.6-luna
# OPENROUTER_TITLE=openai/gpt-5.6-luna
# OPENROUTER_ASK=openai/gpt-5.6-luna
# OPENROUTER_SUMMARY=openai/gpt-5.6-luna
# OPENROUTER_VOCAB=openai/gpt-5.6-luna
# API_BASE=https://yanroku.app
# RUNNER_TOKEN=<the Worker's RUNNER_TOKEN secret>
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=
